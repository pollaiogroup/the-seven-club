# Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# URL pública do app (links de convite e e-mails). Na Vercel pode ficar de fora: o app usa o domínio de produção do projeto.
# NEXT_PUBLIC_SITE_URL=https://app.theseven.club

# Notificações push (gere com: npx web-push generate-vapid-keys)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contato@theseven.club

# Protege a rotina /api/cron/dispatch (a Vercel envia como Bearer)
CRON_SECRET=

# App das lojas (Capacitor): endereço publicado que a casca nativa abre
# CAP_SERVER_URL=https://app.theseven.club

# Assinatura pela landing page (Asaas Checkout)
ASAAS_API_KEY=
# 'sandbox' para testar; sem isso, usa a produção
ASAAS_ENV=sandbox
# O mesmo "token de autenticação" cadastrado no webhook do Asaas (32 a 255 caracteres, sem espaços)
ASAAS_WEBHOOK_TOKEN=
# Os planos e preços ficam em src/lib/plans.ts (Club Online R$ 35,90 e Club São Paulo R$ 99,90).
# Opcional, para trocar um preço sem subir código:
# ASSINATURA_VALOR_ONLINE=35.90
# ASSINATURA_VALOR_SAO_PAULO=99.90
# Onde está a landing page (para voltar a ela se a pessoa desistir do pagamento)
LANDING_URL=https://pollaio.com.br/theseven
CHECKOUT_RETURN_ORIGINS=https://pollaio.com.br,https://www.pollaio.com.br
